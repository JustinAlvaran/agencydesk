{
  "name": "agencydesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm content:prepare && next dev",
    "build": "pnpm content:prepare && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm content:prepare && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:edge": "deno test --no-config --no-lock --node-modules-dir=manual --allow-env supabase/functions/tests",
    "test:database": "node tests/database/verify.mjs && node tests/database/automation.mjs && node tests/database/leads.mjs && node tests/database/inquiry-preferences.mjs && node tests/database/zoko-provider.mjs && node tests/database/recipient-suppression.mjs && node tests/database/website-intake.mjs && node tests/database/service-chat.mjs",
    "test:chat-concurrency": "node tests/database/service-chat-concurrency.mjs",
    "test:hosted": "node tests/database/hosted.mjs",
    "content:prepare": "node --experimental-strip-types scripts/prepare-content.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-chatbotify": "2.5.0",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "22.x"
  }
}
