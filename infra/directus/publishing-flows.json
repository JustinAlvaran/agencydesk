        "key": "select_public_change",
        "name": "Select published change",
        "type": "exec",
        "options": {
          "code": "const collections = [\"site_settings\",\"home_page\",\"services\",\"sample_projects\"];\nfunction shouldRebuild(trigger, kind) {\n  if (!collections.includes(trigger?.collection)) return false;\n  const payload = trigger.payload ?? {};\n  const keys = Object.keys(payload).filter(key => key !== 'id');\n  const visibilityOnly = ['services', 'sample_projects'].includes(trigger.collection)\n    && keys.length === 1 && keys[0] === 'visibility'\n    && ['visible', 'archived'].includes(payload.visibility);\n  return kind === 'visibility' ? visibilityOnly : !visibilityOnly;\n}\nmodule.exports = data => ({ rebuild: shouldRebuild(data.$trigger, \"publication\") });"
        },
        "resolve": "2375b0a6-c4eb-492c-a2f2-2c8ccc10cc03",
        "flow": "8bf856f3-3eeb-4f38-b988-142f03ff60c9",
