# AgencyDesk Environment Configuration Example
# Copy to .env.local for local overrides. Never commit secrets.

# Application URL
APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Configuration (Optional for local memory store; required for cloud sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key

# Server-Side Admin Access (Accepts either SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-admin-key
SUPABASE_SECRET_KEY=your-service-role-admin-key

# Public Website Intake Pipeline
AGENCYDESK_INTAKE_AGENCY_ID=a0000000-0000-4000-8000-000000000001
INTAKE_RATE_SECRET=your-inquiry-hmac-rate-secret
